import Mathlib
import MzSl2.F737b

/-!
# Fact 737, step 4a: the comparison kernel is finitely generated modulo `C`

`B = q⁻¹(U_Λ) = Subgroup.closure ρ(Λ)` is generated by the compact set `K = U ∪ {ρ(w), ρ(u(1))}`
(`SL₂(ℤ) = ⟨S, T⟩`), and `B = E Ω` for a compact `Ω`. A Schreier argument shows that
`E ∩ Ω K Ω⁻¹`, which is covered by finitely many cosets of `C`, generates `E` modulo `C`.
-/

open Matrix Topology Set Subgroup
open scoped Pointwise MatrixGroups

namespace MzSl2

variable {p : ℕ} [hp : Fact p.Prime]

/-! ### `SL₂(ℤ) = ⟨w, u(1)⟩` inside `Γ` -/

/-- The embedding `SL₂(ℤ) → Γ`. -/
noncomputable def ψ : SpecialLinearGroup (Fin 2) ℤ →* Γ p :=
  (φ.codRestrict (Γ p) fun B => Λ_le_Γ p (by rw [Λ_eq_range]; exact ⟨B, rfl⟩))

theorem range_ψ : (ψ (p := p)).range = Λp p := by
  ext g
  constructor
  · rintro ⟨B, rfl⟩
    rw [mem_subgroupOf]
    show φ B ∈ Λ
    rw [Λ_eq_range]; exact ⟨B, rfl⟩
  · intro hg
    rw [mem_subgroupOf, Λ_eq_range] at hg
    obtain ⟨B, hB⟩ := hg
    exact ⟨B, Subtype.ext hB⟩

theorem ψ_S : ψ (p := p) ModularGroup.S = wγ p := by
  apply mat_injective
  show (φ ModularGroup.S : Matrix (Fin 2) (Fin 2) ℚ) = w
  ext i j; rw [φ_coe, ModularGroup.coe_S]
  fin_cases i <;> fin_cases j <;> simp [w]

theorem ψ_T : ψ (p := p) ModularGroup.T = uΓ 1 R_one := by
  apply mat_injective
  show (φ ModularGroup.T : Matrix (Fin 2) (Fin 2) ℚ) = u 1
  ext i j; rw [φ_coe, ModularGroup.coe_T]
  fin_cases i <;> fin_cases j <;> simp [u]

theorem Λp_eq_closure : Λp p = Subgroup.closure {wγ p, uΓ (p := p) 1 R_one} := by
  rw [← range_ψ, MonoidHom.range_eq_map, ← SpecialLinearGroup.SL2Z_generators,
    MonoidHom.map_closure, Set.image_pair, ψ_S, ψ_T]

variable {L : Subgroup (Γ p)} (hL : L ≤ Λp p)

/-- **737 (4a).** -/
theorem exists_finite_gen (hLc : IsCommensurated L) {m : ℕ} (hm : 0 < m)
    (hu : uΓ (p := p) (m : ℚ) (by exact_mod_cast intCast_mem (R p) (m : ℤ)) ∈ L)
    (hv : vΓ (p := p) (m : ℚ) (by exact_mod_cast intCast_mem (R p) (m : ℤ)) ∈ L)
    (C : Subgroup (Hc L)) (hCE : C ≤ (qmap hL).ker) (O : Set (Hc L)) (hO : IsOpen O)
    (hOC : (C : Set (Hc L)) = O ∩ (qmap hL).ker) :
    ∃ F : Set (Hc L), F.Finite ∧ F ⊆ (qmap hL).ker ∧
      ((qmap hL).ker : Set (Hc L)) ⊆ Subgroup.closure (F ∪ (C : Set (Hc L))) := by
  haveI := locallyCompact_Hc L hLc
  set q := qmap hL
  set E := q.ker
  set U := UH L
  set B := (UH (Λp p)).comap q
  set EU := (U.map q).comap q
  have hE_closed : IsClosed (E : Set (Hc L)) :=
    isClosed_singleton.preimage (continuous_qmap hL)
  -- generators of `B`
  set K : Set (Hc L) := (U : Set (Hc L)) ∪ {ρH L (wγ p), ρH L (uΓ 1 R_one)}
  have hKcpt : IsCompact K :=
    (isCompact_UH L hLc).union ((Set.finite_singleton _).insert _).isCompact
  have hKB : Subgroup.closure K ≤ B := by
    rw [closure_le]
    rintro x (hx | hx | hx)
    · exact qmap_UH_le hL ⟨x, hx, rfl⟩
    · rw [hx]; show q (ρH L (wγ p)) ∈ UH (Λp p); rw [qmap_ρH]
      exact (ρH_mem_UH_iff _ _).mpr (by rw [Λp_eq_closure]; exact Subgroup.subset_closure (by simp))
    · rw [hx]; show q (ρH L (uΓ 1 R_one)) ∈ UH (Λp p); rw [qmap_ρH]
      exact (ρH_mem_UH_iff _ _).mpr (by rw [Λp_eq_closure]; exact Subgroup.subset_closure (by simp))
  have hBK : (B : Set (Hc L)) ⊆ Subgroup.closure K := by
    have hopen : IsOpen (Subgroup.closure K : Set (Hc L)) :=
      Subgroup.isOpen_mono (le_trans (by intro x hx; exact Subgroup.subset_closure (Or.inl hx))
        le_rfl) (isOpen_UH L)
    have hcl := Subgroup.isClosed_of_isOpen _ hopen
    have hB : (B : Set (Hc L)) = _root_.closure (ρH L '' (Λp p : Set (Γ p))) :=
      qmap_preimage_UH hL
    rw [hB]
    refine closure_minimal ?_ hcl
    rintro _ ⟨l, hl, rfl⟩
    rw [Λp_eq_closure] at hl
    have : (Subgroup.closure {wγ p, uΓ (p := p) 1 R_one}).map (ρH L) ≤ Subgroup.closure K := by
      rw [MonoidHom.map_closure, closure_le]
      rintro _ ⟨y, hy, rfl⟩
      rcases hy with rfl | rfl
      · exact Subgroup.subset_closure (Or.inr (Or.inl rfl))
      · exact Subgroup.subset_closure (Or.inr (Or.inr rfl))
    exact this ⟨l, hl, rfl⟩
  -- `B = E Ω`
  have hEUB : EU.relIndex B ≠ 0 := by
    rw [relIndex_comap]
    exact relIndex_ne_zero_of_le_right' (map_comap_le _ _)
      (relIndex_ne_zero_of_isOpen_of_isCompact (qmap_UH_isOpen hL hLc hm hu hv)
        (isCompact_UH _ Λp_commensurated))
  haveI : (EU.subgroupOf B).FiniteIndex := ⟨hEUB⟩
  haveI : Finite (B ⧸ EU.subgroupOf B) := inferInstance
  set reps : Set (Hc L) := Set.range fun c : B ⧸ EU.subgroupOf B => ((c.out : B) : Hc L)
  set Ω : Set (Hc L) := insert 1 (reps * (U : Set (Hc L)))
  have hΩcpt : IsCompact Ω :=
    ((Set.finite_range _).isCompact.mul (isCompact_UH L hLc)).insert 1
  have hΩB : Ω ⊆ (B : Set (Hc L)) := by
    rintro x (rfl | ⟨r, ⟨c, rfl⟩, u, hu', rfl⟩)
    · exact B.one_mem
    · exact B.mul_mem (c.out).2 (qmap_UH_le hL ⟨u, hu', rfl⟩)
  have hcover : ∀ b ∈ B, ∃ ω ∈ Ω, b * ω⁻¹ ∈ E := by
    intro b hb
    obtain ⟨h, he⟩ := QuotientGroup.mk_out_eq_mul (EU.subgroupOf B) (⟨b, hb⟩ : B)
    set c : B ⧸ EU.subgroupOf B := QuotientGroup.mk ⟨b, hb⟩
    have hout : ((c.out : B) : Hc L) = b * ((h : B) : Hc L) := by
      have := congrArg Subtype.val he; simpa using this
    have hhEU : ((h : B) : Hc L) ∈ EU := mem_subgroupOf.mp h.2
    obtain ⟨u, hu', hqu⟩ := hhEU
    -- `h = e u` with `q e = 1`
    refine ⟨((c.out : B) : Hc L) * u⁻¹, Or.inr ⟨_, ⟨c, rfl⟩, u⁻¹, U.inv_mem hu', rfl⟩, ?_⟩
    show q (b * (((c.out : B) : Hc L) * u⁻¹)⁻¹) = 1
    rw [hout, map_mul, map_inv, map_mul, map_mul, map_inv, ← hqu]
    group
  -- finitely many cosets of `C` cover `E ∩ Ω K Ω⁻¹`
  set Q : Set (Hc L) := (E : Set (Hc L)) ∩ (Ω * K * Ω⁻¹)
  have hQcpt : IsCompact Q :=
    ((hΩcpt.mul hKcpt).mul hΩcpt.inv).inter_left hE_closed
  have h1O : (1 : Hc L) ∈ O := by
    have : (1 : Hc L) ∈ (C : Set (Hc L)) := C.one_mem
    rw [hOC] at this; exact this.1
  obtain ⟨t, htQ, htfin, hcov⟩ := hQcpt.elim_finite_subcover_image (b := Q)
    (c := fun f : Hc L => (fun y => f⁻¹ * y) ⁻¹' O)
    (fun f _ => hO.preimage (continuous_const.mul continuous_id))
    (fun x hx => Set.mem_biUnion hx (by simp [h1O]))
  have hQC : ∀ x ∈ Q, ∃ f ∈ t, f⁻¹ * x ∈ C := by
    intro x hx
    obtain ⟨f, hft, hxf⟩ := Set.mem_iUnion₂.mp (hcov hx)
    refine ⟨f, hft, ?_⟩
    rw [← SetLike.mem_coe, hOC]
    refine ⟨hxf, ?_⟩
    have hfE : f ∈ E := (htQ hft).1
    exact E.mul_mem (E.inv_mem hfE) hx.1
  refine ⟨t, htfin, fun f hf => (htQ hf).1, ?_⟩
  set S := Subgroup.closure (t ∪ (C : Set (Hc L)))
  have hQS : ∀ x ∈ Q, x ∈ S := fun x hx => by
    obtain ⟨f, hft, hfx⟩ := hQC x hx
    have : x = f * (f⁻¹ * x) := by group
    rw [this]; exact S.mul_mem (Subgroup.subset_closure (Or.inl hft)) (Subgroup.subset_closure (Or.inr hfx))
  have hmemQ : ∀ ω0 ∈ Ω, ∀ x ∈ K, ∀ ω ∈ Ω, ω0 * x * ω⁻¹ ∈ E → ω0 * x * ω⁻¹ ∈ Q :=
    fun ω0 hω0 x hx ω hω hE =>
      ⟨hE, Set.mem_mul.mpr ⟨ω0 * x, Set.mem_mul.mpr ⟨ω0, hω0, x, hx, rfl⟩, ω⁻¹,
        Set.inv_mem_inv.mpr hω, rfl⟩⟩
  -- the Schreier induction
  have key : ∀ x (hx : x ∈ Subgroup.closure K), ∀ ω0 ∈ Ω, ∀ ω ∈ Ω,
      ω0 * x * ω⁻¹ ∈ E → ω0 * x * ω⁻¹ ∈ S := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hxK => exact fun ω0 hω0 ω hω hE => hQS _ (hmemQ ω0 hω0 x hxK ω hω hE)
    | one => exact fun ω0 hω0 ω hω hE => hQS _ (hmemQ ω0 hω0 1 (Or.inl U.one_mem) ω hω hE)
    | mul x y hx hy ihx ihy =>
      intro ω0 hω0 ω hω hE
      obtain ⟨ω1, hω1, h1⟩ := hcover (ω0 * x) (B.mul_mem (hΩB hω0) (hKB hx))
      have hx' : ω0 * x * ω1⁻¹ ∈ S := ihx ω0 hω0 ω1 hω1 h1
      have hyE : ω1 * y * ω⁻¹ ∈ E := by
        have := E.mul_mem (E.inv_mem h1) hE
        have e : (ω0 * x * ω1⁻¹)⁻¹ * (ω0 * (x * y) * ω⁻¹) = ω1 * y * ω⁻¹ := by group
        rwa [e] at this
      have hy' := ihy ω1 hω1 ω hω hyE
      have e : ω0 * (x * y) * ω⁻¹ = (ω0 * x * ω1⁻¹) * (ω1 * y * ω⁻¹) := by group
      rw [e]; exact S.mul_mem hx' hy'
    | inv x hx ihx =>
      intro ω0 hω0 ω hω hE
      have hE' : ω * x * ω0⁻¹ ∈ E := by
        have := E.inv_mem hE
        have e : (ω0 * x⁻¹ * ω⁻¹)⁻¹ = ω * x * ω0⁻¹ := by group
        rwa [e] at this
      have := S.inv_mem (ihx ω hω ω0 hω0 hE')
      have e : (ω * x * ω0⁻¹)⁻¹ = ω0 * x⁻¹ * ω⁻¹ := by group
      rwa [e] at this
  intro e he
  have heB : e ∈ B := by
    show q e ∈ UH (Λp p); rw [show q e = 1 from he]; exact (UH _).one_mem
  have := key e (hBK heB) 1 (Set.mem_insert _ _) 1 (Set.mem_insert _ _) (by simpa using he)
  simpa using this

end MzSl2
